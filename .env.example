# Copy to .env.local for local work. In Vercel add the same names under Settings -> Environment Variables.
# NEVER commit real values. Find them in Supabase -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your site address, used in invitation / password-reset emails (e.g. https://sbsss-result-erp.vercel.app)
NEXT_PUBLIC_SITE_URL=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for sending invitations and uploading the logo.
SUPABASE_SERVICE_ROLE_KEY=
